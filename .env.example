# GitHub Personal Access Token (read-only, public_repo scope)
GITHUB_TOKEN=ghp_your_token_here

# LLM Provider: "groq", "openai", or "anthropic"
LLM_PROVIDER=groq

# LLM API Key (Groq, OpenAI, or Anthropic)
LLM_API_KEY=your_api_key_here

# LLM Model (examples: llama-3.3-70b-versatile for Groq, gpt-4o-mini for OpenAI)
LLM_MODEL=llama-3.3-70b-versatile
